# Neon: copy the pooled connection string from the Neon console
DATABASE_URL=postgres://USER:PASSWORD@HOST/neondb?sslmode=require

# Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Models are written provider:model-id. Defaults used for everyone.
# Candidates under test: anthropic:claude-sonnet-5-5, anthropic:claude-haiku-4-5-20251001, openai:gpt-6.1-sol, openai:gpt-6-luna
AI_MODEL_PLAN=anthropic:claude-sonnet-5-5
AI_MODEL_FAST=anthropic:claude-haiku-4-5-20251001
# Only these may be chosen by the live-test override (comma separated)
AI_MODEL_ALLOWLIST=anthropic:claude-sonnet-5-5,anthropic:claude-haiku-4-5-20251001,openai:gpt-6.1-sol,openai:gpt-6-luna
# Secret that unlocks the model override page (/dev/models). Leave empty to disable the override in production.
MODEL_SWITCH_KEY=

# Speech to text: webspeech (client only) | openai (Whisper, server) 
# Web Speech is used first in browsers that have it; the server transcriber (Whisper) is the fallback and the one for iOS.
STT_PROVIDER=openai
STT_MODEL=whisper-1

# Cost and abuse control
DAILY_AI_CALL_LIMIT=40
MAX_DUMP_CHARS=4000
MAX_AUDIO_SECONDS=120

# Public
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google sign-in (Auth.js), required from Phase 3. Nobody can use the app without signing in.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

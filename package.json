{
  "name": "untangle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "node scripts/gen-prompts.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json",
    "lint": "eslint .",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "eval": "tsx scripts/eval.ts",
    "prompts": "node scripts/gen-prompts.mjs",
    "e2e": "playwright test",
    "e2e:pwa": "playwright test -c playwright.pwa.config.ts",
    "db:migrate:test": "MIGRATE_URL=\"$(grep ^TEST_DATABASE_URL= .env.local | cut -d= -f2-)\" drizzle-kit migrate",
    "test:db": "tsx --env-file=.env.local scripts/db-integration.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/openai": "^4.0.83",
    "@neondatabase/serverless": "^1.2.0",
    "ai": "^7.0.126",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.8",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "serwist": "^9.5.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@serwist/next": "^9.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
